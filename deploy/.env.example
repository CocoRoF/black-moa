# ── black-moa production env (copy to deploy/.env, chmod 600) ─────────────────────
# Public URL (Cloudflare tunnel hostname)
BLACKMOA_PUBLIC_URL=https://black.memo-ora.com

# JWT/HKDF root secret: openssl rand -hex 32
# Rotating this invalidates sessions/visitor tokens. See deploy/README.md before
# rotating an existing install that used derived encryption keys.
BLACKMOA_SECRET_KEY=

# One-time first-admin bootstrap token: openssl rand -hex 32
# Remove/rotate after the first production admin is created.
BLACKMOA_BOOTSTRAP_TOKEN=

# Seeded administrator, created at boot when the address is free.
# The shipped password is a convenience for first login - CHANGE IT from
# my page right after logging in (the console warns until you do), or set a
# real one here before the first boot. BLACKMOA_DEFAULT_ADMIN_ENABLED=0 skips the
# seed entirely and falls back to "the first signup becomes the admin".
BLACKMOA_DEFAULT_ADMIN_ENABLED=true
BLACKMOA_DEFAULT_ADMIN_EMAIL=admin@geny.com
BLACKMOA_DEFAULT_ADMIN_PASSWORD=admin123

# Independent Fernet key for encrypted DB secrets.
# Generate: docker compose -p blackmoa run --rm --no-deps backend python -m blackmoa.core.keytool generate
# Existing installs with this previously empty MUST follow deploy/README.md and
# pin the legacy derived key before rotating BLACKMOA_SECRET_KEY.
BLACKMOA_ENCRYPTION_KEY=
# Comma-separated decrypt-only old Fernet keys during staged rotation.
BLACKMOA_ENCRYPTION_KEY_PREVIOUS=

# User-controlled outbound URL policy (safe HTTP transport DNS-pins actual TCP IPs).
BLACKMOA_OUTBOUND_ALLOWED_PORTS=80,443

# Untrusted document parser child-process ceilings.
BLACKMOA_PARSER_TIMEOUT_SECONDS=20
BLACKMOA_PARSER_MEMORY_MB=512
BLACKMOA_PARSER_MAX_OUTPUT_BYTES=8388608

# Postgres
POSTGRES_DB=blackmoa
POSTGRES_USER=blackmoa
POSTGRES_PASSWORD=

# SeaweedFS S3 gateway credential (uploads, vault blobs): openssl rand -hex 32
S3_ACCESS_KEY=blackmoa
S3_SECRET_KEY=

# Host port nginx binds on 127.0.0.1 (cloudflared ingress -> http://localhost:58710)
NGINX_PORT=58710
TZ=Asia/Seoul
BLACKMOA_LOG_LEVEL=INFO
CLAUDE_CODE_VERSION=2.1.236

# Container budgets. Unset = sized for a host of its own (deploy/docker-compose.yml). On a host
# shared with another stack, set them so both stacks together stay under the machine's memory.
# BLACKMOA_POSTGRES_MEM=1536m
# BLACKMOA_POSTGRES_MEM_RESERVE=384m
# BLACKMOA_PG_SHARED_BUFFERS=256MB
# BLACKMOA_PG_EFFECTIVE_CACHE=1024MB
# BLACKMOA_BACKEND_MEM=2560m
# BLACKMOA_BACKEND_MEM_RESERVE=512m
# BLACKMOA_WORKER_MEM=1536m
# BLACKMOA_WORKER_MEM_RESERVE=256m
# BLACKMOA_FRONTEND_MEM=512m
# BLACKMOA_FRONTEND_MEM_RESERVE=128m
# BLACKMOA_SEAWEEDFS_MEM=512m
# BLACKMOA_SEAWEEDFS_MEM_RESERVE=128m
