# Memora encrypted backup settings. Copy to deploy/backup.env and chmod 600.
# This file is not application runtime configuration; keep it only on the host.

# Host directory for local encrypted archives.
MEMORA_BACKUP_DIR=/srv/memora-backups

# Public age recipient. Generate a keypair with: age-keygen -o /root/.config/memora/backup-age.key
# Put ONLY the public age1... recipient here.
MEMORA_BACKUP_AGE_RECIPIENT=age1REPLACE_ME

# Verification uses the private identity file path; never paste the private key into env.
MEMORA_BACKUP_AGE_IDENTITY=/root/.config/memora/backup-age.key
MEMORA_BACKUP_RETENTION_DAYS=28

# Off-site copy over ssh. An archive that only lives on the machine it was taken from is
# not a backup — the disk that loses the database loses it too. The far side receives age
# ciphertext only; keep the identity somewhere else.
# MEMORA_BACKUP_OFFSITE_SSH=user@host
# MEMORA_BACKUP_OFFSITE_DIR=/home/user/backup/memora
# MEMORA_BACKUP_OFFSITE_PORT=22
# MEMORA_BACKUP_OFFSITE_KEY=/root/.ssh/memora_backup_ed25519
# MEMORA_BACKUP_OFFSITE_KEEP=14

# Optional off-site copy via restic. Leave empty to disable.
# Examples: s3:s3.amazonaws.com/my-bucket/memora, sftp:user@host:/backups/memora
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/root/.config/memora/restic-password

# Provider-specific restic credentials (AWS_*, B2_*, AZURE_*, etc.) may also be
# supplied by the host/service manager. Do not commit secret values here.
